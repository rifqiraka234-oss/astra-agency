# Copy to .env.local for local development. Never commit .env.local.
DATABASE_URL=postgres://astra:astra@localhost:5432/astra_crm
# Any long random string. Signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Shows the "Sample data" badge in the header and lets the seed run.
SAMPLE_DATA=true
# V1 never sends. Leave false. When false the approval queue only approves.
SEND_ENABLED=false
