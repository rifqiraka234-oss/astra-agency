# =============================================================================
# Astra x Lemlist Autonomous Reply Agent - environment configuration
# =============================================================================
# Copy to .env and fill in. EVERY live-action flag defaults to false / blocked.
# Nothing in this file should ever be committed with real values.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Postgres connection string used by the worker, dashboard and migrations.
DATABASE_URL=postgres://astra:astra@localhost:5432/astra_reply_agent
# 32-byte key, base64 encoded, used for AES-256-GCM encryption of stored
# OAuth refresh tokens and other sensitive integration data.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Runtime mode and hard safety boundaries --------------------------------
# TEST | SHADOW | DRAFT_ONLY | LOW_RISK_AUTO | HUMAN_ONLY
RUNTIME_MODE=TEST
# When true, EVERY external write is blocked immediately, regardless of mode.
GLOBAL_KILL_SWITCH=true
# Each of these must be explicitly true before the matching external write is
# even considered. They are additive to RUNTIME_MODE, never a replacement.
ALLOW_LIVE_LEMLIST_SEND=false
ALLOW_LIVE_CALENDAR_WRITE=false
ALLOW_LIVE_NETLIFY_DEPLOY=false
ALLOW_LIVE_WEBHOOK_REGISTRATION=false
# NOTE: there is deliberately NO flag that permits automatic prototype-link
# delivery. Prototype links always require an authenticated operator approval.

# --- Operator and campaign allowlist ----------------------------------------
# The single operator allowed to sign in to the private dashboard.
ADMIN_EMAIL=
# Comma separated Lemlist campaign IDs eligible for automation. Anything else
# is ingested, audited and ignored.
ENABLED_CAMPAIGN_IDS=
# Webhook payloads whose teamId does not match are rejected.
EXPECTED_LEMLIST_TEAM_ID=

# --- Lemlist ----------------------------------------------------------------
LEMLIST_API_KEY=
# Shared secret Lemlist includes in the webhook JSON body. Compared in
# constant time; redacted from every log line.
LEMLIST_WEBHOOK_SECRET=
# Lemlist user whose inbox owns created drafts.
LEMLIST_DRAFT_OWNER=
# Lemlist user id used as the LinkedIn/email sender.
LEMLIST_SEND_USER_ID=
LEMLIST_API_BASE_URL=https://api.lemlist.com

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_PROTOTYPE_MODEL=claude-sonnet-4-5-20250929

# --- Netlify (prototype hosting) --------------------------------------------
NETLIFY_ACCESS_TOKEN=
NETLIFY_TEAM_SLUG=
NETLIFY_SITE_NAME_SUFFIX=prototype-by-astra

# --- Notification email -----------------------------------------------------
# resend | console  (console writes to the audit log instead of sending)
EMAIL_PROVIDER=console
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- Calendar ---------------------------------------------------------------
# microsoft | google | none   (exactly one provider is active)
CALENDAR_PROVIDER=none
CALENDAR_ACCOUNT_EMAIL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduling -------------------------------------------------------------
OPERATOR_TIMEZONE=Europe/Amsterdam
WORKDAY_START=09:00
WORKDAY_END=18:00
MEETING_DURATION_MINUTES=20
MEETING_BUFFER_MINUTES=10
MEETING_MIN_NOTICE_HOURS=4
MEETING_SEARCH_BUSINESS_DAYS=5
MEETING_SEARCH_BUSINESS_DAYS_MAX=10
SLOT_RESERVATION_HOURS=24
# Recurring weekly exclusions and blackout dates live in a validated JSON file
# rather than fragile comma separated prose. See config/scheduling.json.
SCHEDULING_CONFIG_PATH=config/scheduling.json
# Live free/busy results older than this may not be used to compose slots.
CALENDAR_FRESHNESS_SECONDS=60

# --- Controller thresholds --------------------------------------------------
INBOUND_DEBOUNCE_SECONDS=90
AUTO_SEND_MIN_CONFIDENCE=0.94
ACCEPTANCE_SEND_MIN_CONFIDENCE=0.96
MAX_AUTOMATED_OUTBOUND_PER_CONVERSATION=3
MAX_MEANINGFUL_TURNS_BEFORE_HANDOFF=8
APPROVAL_EXPIRY_HOURS=72

# --- Dashboard session ------------------------------------------------------
# 32+ byte random string used to sign dashboard session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12

# --- Worker -----------------------------------------------------------------
WORKER_PORT=3001
WEBHOOK_MAX_BODY_BYTES=1048576
LOG_LEVEL=info

# --- Retention --------------------------------------------------------------
# Decisions, predicates, reason codes and content hashes are kept indefinitely.
# These control how long the prospect's personal *content* is retained.
RETENTION_RAW_WEBHOOK_DAYS=90
RETENTION_CONVERSATION_CONTENT_DAYS=365
RETENTION_SUPPRESSED_CONTENT_DAYS=30
