{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Astra reply agent scheduling configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone", "workingDays", "workday", "recurringExclusions", "blackoutDates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "timezone": { "type": "string", "description": "IANA timezone, e.g. Europe/Amsterdam" },
    "workingDays": {
      "type": "array",
      "items": {
        "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "workday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "recurringExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "weekday", "start", "end"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "weekday": {
            "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"]
          },
          "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        }
      }
    },
    "blackoutDates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "label"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "label": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        }
      }
    }
  }
}
